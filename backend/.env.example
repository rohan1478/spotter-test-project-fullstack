DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request limits, not weather risk thresholds.
API_MAX_REQUEST_BYTES=65536
ROUTING_MAX_LOCATION_LENGTH=200
ROUTING_MAX_LOAD_LB=200000
ROUTING_MAX_CHECKPOINTS=1000
PROVIDER_TIMEOUT_SECONDS=15

# Open-Meteo evaluation/non-commercial endpoint needs no key.
WEATHER_FORECAST_DAYS=16
WEATHER_MAX_LOCATIONS=300
WEATHER_BATCH_SIZE=20
WEATHER_MAX_WORKERS=3
WEATHER_CACHE_SECONDS=600
ANALYSIS_CACHE_SECONDS=900

# Corridor cells are clipped to the route buffer; spacing coarsens to fit the cap.
CORRIDOR_BUFFER_MILES=15
CORRIDOR_GRID_MILES=10
CORRIDOR_MAX_CELLS=150
CORRIDOR_MAX_CANDIDATES=10000
CORRIDOR_MAX_VERTICES=50000
CORRIDOR_MAX_RADIUS_KM=2000

# Needed for Phase 3 live requests. Keep credentials on the backend only.
MAPBOX_ACCESS_TOKEN=
GEOAPIFY_API_KEY=
